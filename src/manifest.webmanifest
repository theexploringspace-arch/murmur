{
  "name": "Murmur — offline private messenger",
  "short_name": "Murmur",
  "description": "End-to-end encrypted messaging over local Wi-Fi or a hotspot. No servers, no cloud.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
