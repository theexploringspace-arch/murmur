{
  // Murmur relay — deploy with: npx wrangler deploy   (from this folder)
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "murmur-relay",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "routes": [{ "pattern": "relay.princeisgenius.com", "custom_domain": true }],
  "vars": { "ALLOWED_ORIGINS": "https://murmur.princeisgenius.com" },
  "durable_objects": { "bindings": [{ "name": "INBOX", "class_name": "Inbox" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Inbox"] }],
  // Calls: at most 20 TURN credential requests per minute per IP address (per Cloudflare location).
  // The TURN key itself is set as secrets (never in this file):
  //   npx wrangler secret put TURN_KEY_ID      and      npx wrangler secret put TURN_KEY_API_TOKEN
  "ratelimits": [{ "name": "TURN_LIMIT", "namespace_id": "4271", "simple": { "limit": 20, "period": 60 } }],
  "observability": { "enabled": false }
}
